{
  "env": "development",

  "infra": {
    "postgresSuperuser": "postgres",
    "postgresSuperuserPassword": "CHANGE_ME"
  },

  "shared": {
    "postgres": {
      "host": "localhost",
      "port": 5432,
      "database": "aerotrack",
      "sslmode": "disable",
      "connectTimeoutSeconds": 5,
      "startupRetries": 30
    },
    "redis": {
      "host": "localhost",
      "port": 6379,
      "password": "CHANGE_ME",
      "db": 0
    },
    "jwt": {
      "issuer": "aerotrack-auth",
      "userAudience": "aerotrack-user",
      "adminAudience": "aerotrack-admin",
      "accessTtlSeconds": 900,
      "refreshTtlSeconds": 604800
    },
    "internalToken": "CHANGE_ME"
  },

  "auth": {
    "listen": "0.0.0.0:7001",
    "db": { "schema": "auth", "user": "auth_svc", "password": "CHANGE_ME" },
    "github": {
      "clientId": "",
      "clientSecret": "",
      "callbackUrl": "http://localhost:8080/api/auth/github/callback",
      "scopes": ["read:user", "user:email"],
      "authorizeUrl": "https://github.com/login/oauth/authorize",
      "tokenUrl": "https://github.com/login/oauth/access_token",
      "apiBaseUrl": "https://api.github.com"
    },
    "admin": {
      "bootstrapUsername": "admin",
      "bootstrapPassword": "CHANGE_ME",
      "maxFailedAttempts": 5,
      "lockoutMinutes": 15,
      "minPasswordLength": 12
    },
    "cookies": {
      "secure": false,
      "sameSite": "lax",
      "userAccess": "aerotrack_at",
      "userRefresh": "aerotrack_rt",
      "userRefreshPath": "/api/auth",
      "adminAccess": "aerotrack_admin_at",
      "adminRefresh": "aerotrack_admin_rt",
      "adminRefreshPath": "/api/admin/auth",
      "oauthState": "aerotrack_oauth_state",
      "oauthStatePath": "/api/auth/github"
    },
    "jwtPrivateKeyPath": "keys/jwt-private.pem",
    "jwtPublicKeyPath": "keys/jwt-public.pem",
    "portals": {
      "userUrl": "http://localhost:4200",
      "adminUrl": "http://localhost:4201"
    }
  },

  "tracking": {
    "listen": "0.0.0.0:7002",
    "db": { "schema": "tracking", "user": "tracking_svc", "password": "CHANGE_ME" },
    "provider": "simulator",
    "watchProvider": "adsbLol",
    "calls": {
      "opensky": {
        "baseUrl": "https://opensky-network.org/api",
        "tokenUrl": "https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token",
        "clientId": "",
        "clientSecret": "",
        "pollIntervalSeconds": 90,
        "timeoutSeconds": 30
      },
      "adsbLol": {
        "baseUrl": "https://api.adsb.lol/v2",
        "apiKey": "",
        "pollIntervalSeconds": 5,
        "timeoutSeconds": 10,
        "maxConcurrent": 5
      },
      "simulator": {
        "airlines": ["AIC", "IGO", "AAL", "DAL", "UAL", "BAW", "DLH", "AFR", "KLM", "UAE", "QTR", "SIA", "THY", "QFA", "ANA"],
        "flightsPerAirline": 20,
        "tickSeconds": 2,
        "seed": 42
      }
    },
    "maxTrackedFlights": 5,
    "staleAfterSeconds": 300,
    "watchTtlSeconds": 60,
    "trail": { "sampleSeconds": 30, "maxPoints": 240 }
  },

  "analytics": {
    "listen": "0.0.0.0:7003",
    "db": { "schema": "analytics", "user": "analytics_svc", "password": "CHANGE_ME" },
    "secretKeyBase": "CHANGE_ME",
    "calls": {
      "prometheus": "http://127.0.0.1:9090",
      "auth": "http://127.0.0.1:7001",
      "tracking": "http://127.0.0.1:7002",
      "timeoutSeconds": 5
    },
    "streams": {
      "auth": "events:auth",
      "tracking": "events:tracking",
      "group": "analytics",
      "batchSize": 500,
      "blockMs": 5000
    }
  }
}
