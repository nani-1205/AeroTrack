source "https://rubygems.org"

# Minimal Rails API: only the frameworks we use.
gem "railties", "~> 8.1"
gem "activerecord", "~> 8.1"
gem "actionpack", "~> 8.1"

gem "pg", "~> 1.6"
gem "puma", ">= 6.6"
gem "redis", "~> 5.4"
gem "prometheus-client", "~> 4.2"

# Windows has no system zoneinfo database.
gem "tzinfo-data", platforms: %i[windows jruby]
# Process memory on Windows (psapi) — a bundled, not default, gem since Ruby 3.5.
gem "fiddle", platforms: %i[windows]
