{
  "name": "@aerotrack/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "AeroTrack API gateway — routing, auth enforcement, rate limiting, live-position WebSocket",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/http-proxy": "^11.6.10",
    "@fastify/rate-limit": "^11.3.0",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.18",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
